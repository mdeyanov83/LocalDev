# Use Microsoft base devcontainer image
FROM mcr.microsoft.com/devcontainers/base:ubuntu
LABEL maintainer="Martin Deyanov <your.email@example.com>"

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/venv/bin:$PATH"

# Install system packages and clean up in single layer
RUN apt-get update && apt-get install --no-install-recommends --no-install-suggests -y \
    # Core utilities
    curl wget git unzip zip gnupg2 software-properties-common \
    lsb-release sudo ca-certificates iputils-ping\
    # Python ecosystem
    python3 python3-pip python3-venv \
    # Build tools
    build-essential gdb cmake xz-utils bash-completion valgrind\
    # SQLite Database
    sqlite3 libsqlite3-dev \
    # Additional useful tools
    htop tree nano jq socat \
    # Cleanup in same layer
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create virtual environment and install Python packages as vscode user
RUN python3 -m venv /opt/venv \
    && . /opt/venv/bin/activate \
    && pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir \
	# Data Science stack
        numpy scipy matplotlib scikit-learn \
	# Jupyter ecosystem (commented out)
        # jupyterlab ipython notebook \
	# Web frameworks
        requests beautifulsoup4 flask django fastapi \
	uvicorn websockets httpx \
	# Development Tools
        black pylint mypy pytest pytest-cov \
	# Utilities
        tqdm pip-tools python-dotenv pillow \
    && pip cache purge

# Install Docker CLI
RUN install -d /etc/apt/keyrings -m 0755 \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install --no-install-recommends -y docker-ce-cli \
    && groupadd -f docker \
    && usermod -aG docker vscode \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install --no-install-recommends -y gh \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install Node.js and TypeScript, clean up in same layer
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get update \
    && apt-get install -y nodejs \
    && npm install -g typescript ts-node @types/node nodemon \
    && rm -rf /var/lib/apt/lists/* \
    && npm cache clean --force \
    && apt-get clean

# Set proper ownership
RUN chown -R vscode:vscode /opt/venv

# Switch to vscode user before creating venv (avoids chown)
USER vscode
WORKDIR /home/vscode
