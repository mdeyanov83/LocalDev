{
    "folders": [
        {
            "name": "ROOT (Config)",
            "path": "."
        },
        {
            "name": "Learning",
            "path": "learning"
        },
        {
            "name": "FastAPI Masterclass",
            "path": "fastapi_masterclass"
        },
    ],

    "settings": {

    // Python settings
        // "[python]": {
        //     "editor.defaultFormatter": "ms-python.autopep8",
        //     "editor.formatOnSave": true,
        //     "editor.codeActionsOnSave": {
        //         "source.organizeImports": "explicit"
        //     },
        // },
        "[python]": {
            "editor.defaultFormatter": "charliermarsh.ruff",
            "editor.formatOnSave": true,
            "editor.codeActionsOnSave": {
                // This replaces your "organizeImports" and runs it via Ruff
                "source.fixAll.ruff": "explicit",
                "source.organizeImports.ruff": "explicit"
            }
        },
        // "python.useEnvironmentsExtension": true, // default: false // breaks "python.terminal.activateEnvironment": true,
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        // "python.languageServer": "Pylance", // default: "default" - pylance if available, if not - jedi
        "python.terminal.activateEnvironment": false,
        "python.terminal.launchArgs": [],
        "python.terminal.executeInFileDir": true,

        "autoDocstring.docstringFormat": "google", // default: "google" - autoDocstring extension default format


        // Pylance optimization:
        // "python.analysis.typeCheckingMode": "standard", // default: "off"
        "python.analysis.autoImportCompletions": false, // default: false (significant performance impact on intellisense when enabled)
        "python.analysis.indexing": false, // default: true (Disable indexing of third-party libraries for auto-imports)
        "python.analysis.exclude": [ // Ignore specific heavy folders
            "**/node_modules",
            "**/__pycache__",
            "**/site-packages",
            "**/.venv",
            "**/build",
            "**/dist"
        ],
        "python.analysis.ignore": ["*"], // let Ruff handle errors
        "python.analysis.userFileIndexingLimit": 2000, // default: 200 (Set the analysis limit - helps with CPU spikes)
        "python.analysis.diagnosticMode":   "openFilesOnly", // default: "openFilesOnly" (Change the "diagnostic" mode to only analyze open files)

        "ruff.enable": true,
        // "ruff.configuration": "/path/to/configuration/ruff.toml" // can use a global configuration file, instead of inline JSON object
        "ruff.configuration": {
            "format": {
                "quote-style": "single"
            },

            // "src": ["."], // This tells Ruff that your project code starts at the root, for separating local imports vs 3rd libraries. // Doesn't work byitself, as it cannot anchor where the project root is.
            // "src": ["src"] // This is the "proper" way. Place all source code in src/ and install local project via "pip install -e ." in editable mode.
            "lint": {
                "select": [
                    "I",     // Enforce Import sorting (isort)
                    "E",     // Pycodestyle errors
                    "F"      // Pyflakes
                ],
                "unfixable": ["F401"],  // Prevent Ruff from fixing "unused imports", only warn about them (F401 rule from Pyflakes)
                "ignore": [],
                // "isort": {
                //     "combine-as-imports": false,  // default: false
                //     "force-single-line": false  // default: false
                // }
            }
        },


    // Jupyter Notebooks
        // "notebook.lineNumbers": "on", // default: "off"
        "notebook.output.wordWrap": true, // default: false


    // Java settings
        // "[java]": {
        //     "editor.defaultFormatter": "google.java-format"
        // },
        // "java.debug.settings.enableRunDebugCodeLens": false,
        // "java.inlayHints.parameterNames.enabled": "none",

    // JavaScript/TypeScript settings
        "[javascript]": {
            "editor.defaultFormatter": "esbenp.prettier-vscode",
            "editor.formatOnSave": true,
            "prettier.singleQuote": true  // default: false
        },
        // "js/ts.suggest.enabled": true, // default: true
        // "js/ts.validate.enabled": true, // default: true
        // "js/ts.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false, // default: true
        "[typescript]": {
            "editor.defaultFormatter": "esbenp.prettier-vscode",
            "editor.formatOnSave": true,
            "prettier.singleQuote": true  // default: false
        },


    // HTML
        "html.format.indentInnerHtml": true,  // this setting is from the built-in VS Code HTML formatter. Change it switch to Prettier
        "html.autoClosingTags": true,
        "html.autoCreateQuotes": true,
        "html.suggest.html5": false,  // default: true // suggest only basic HTML tags (no HTML5 specific)


    // CSS
        "[css]": {
            "editor.defaultFormatter": "esbenp.prettier-vscode",
        },

    // JSON/YAML/TOML settings
        "[json]": {
            "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonc]": {
            "editor.defaultFormatter": "esbenp.prettier-vscode",
            "prettier.tabWidth": 4  // default: 2
        },
        "[yaml]": {
            "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        // "[toml]": {

        // },


    // SQL settings
        "[SQL]": {
            "editor.defaultFormatter": "inferrinizzard.prettier-sql-vscode"
        },
        "Prettier-SQL.keywordCase": "upper", // default: "preserve"


    // C_C++ settings
        "C_Cpp.formatting": "clangFormat",
        "C_Cpp.clang_format_fallbackStyle": "{ AllowShortFunctionsOnASingleLine: Empty, BraceWrapping: { AfterCaseLabel: true, AfterControlStatement: true, AfterFunction: true, AfterStruct: true, BeforeElse: true, BeforeWhile: true }, BreakBeforeBraces: Custom, ColumnLimit: 100, IndentCaseLabels: true, IndentWidth: 4, SpaceAfterCStyleCast: true, TabWidth: 4 }",
        "C_Cpp.enhancedColorization": "enabled",
        // "C_Cpp.autocomplete": "disabled",
        // "C_Cpp.debugShortcut": false,
        // "C_Cpp.errorSquiggles": "disabled",
        // "C_Cpp.codeFolding": "disabled",
        // "C_Cpp.dimInactiveRegions": false,
        // "C_Cpp.doxygen.generateOnType": false,


    // Dart/Flutter settings
