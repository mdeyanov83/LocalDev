        "python.terminal.activateEnvironment": false,  // default: true
        // "python.terminal.activateEnvInCurrentTerminal": true,  // default: false
        "python.defaultInterpreterPath": "/opt/venv/bin/python",

        // "python.languageServer": "Pylance", // default: "default" - pylance if available, if not - jedi

        "python.terminal.launchArgs": [],
        "python.terminal.executeInFileDir": true,

        "autoDocstring.docstringFormat": "google", // default: "google" - autoDocstring extension default format

        // Pylance optimization:
        // "python.analysis.typeCheckingMode": "standard", // default: "off"
        "python.analysis.autoImportCompletions": false, // default: false (significant performance impact on intellisense when enabled)
        "python.analysis.indexing": false, // default: true (Disable indexing of third-party libraries for auto-imports)
        "python.analysis.exclude": [ // Ignore specific heavy folders
            "**/node_modules",
            "**/__pycache__",
            "**/site-packages",
            "**/.venv",
            "**/build",
            "**/dist"
        ],
        "python.analysis.ignore": ["*"], // let Ruff handle errors
        "python.analysis.userFileIndexingLimit": 2000, // default: 200 (Set the analysis limit - helps with CPU spikes)
        "python.analysis.diagnosticMode":   "openFilesOnly", // default: "openFilesOnly" (Change the "diagnostic" mode to only analyze open files)

        "ruff.enable": true,
        // "ruff.configuration": "/path/to/configuration/ruff.toml" // can use a global configuration file, instead of inline JSON object
        "ruff.configuration": {
            "format": {
                "quote-style": "single"
            },

            // "src": ["."], // This tells Ruff that your project code starts at the root, for separating local imports vs 3rd libraries. // Doesn't work byitself, as it cannot anchor where the project root is.
            // "src": ["src"] // This is the "proper" way. Place all source code in src/ and install local project via "pip install -e ." in editable mode.
            "lint": {
                "select": [
                    "I",     // Enforce Import sorting (isort)
                    "E",     // Pycodestyle errors
                    "F"      // Pyflakes
                ],
                "unfixable": ["F401"],  // Prevent Ruff from fixing "unused imports", only warn about them (F401 rule from Pyflakes)
                "ignore": [],
                // "isort": {
                //     "combine-as-imports": false,  // default: false
                //     "force-single-line": false  // default: false
                // }
            }
        },


