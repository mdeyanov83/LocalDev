{
    "folders": [
        {
            "name": "ROOT (Config)",
            "path": "."
        },
        {
            "name": "Learning",
            "path": "learning"
        },
        {
            "name": "FastAPI Masterclass",
            "path": "fastapi_masterclass"
        },
    ],

    "settings": {

    // Python settings
        "[python]": {
            "editor.defaultFormatter": "ms-python.autopep8",
            "editor.formatOnSave": true,
            "editor.codeActionsOnSave": {
                "source.organizeImports": "explicit"
            },
        },
        // "python.linting.enabled": true,
        // "python.linting.pylintEnabled": true,
        // "python.languageServer": "Pylance", // default: "default" - pylance if available, if not - jedi
        "python.analysis.autoImportCompletions": true, // default: false
        // "python.analysis.typeCheckingMode": "standard", // default: false
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "python.terminal.launchArgs": [],
        "python.terminal.executeInFileDir": true,

        "autoDocstring.docstringFormat": "google", // default: "google" - autoDocstring extension default format

        // Pylnce optimization:
        // 1. Disable indexing of third-party libraries for auto-imports
        "python.analysis.indexing": false,
        // 2. Tell Pylance to ignore specific heavy folders
        "python.analysis.exclude": [
            "**/node_modules",
            "**/site-packages"
        ],
        // 3. Set the analysis limit (helps with CPU spikes)
        "python.analysis.userFileIndexingLimit": 2000,
        // 4. Change the "diagnostic" mode to only analyze open files
        "python.analysis.diagnosticMode": "openFilesOnly",


    // Jupyter Notebooks
        // "notebook.lineNumbers": "on", // default: "off"
        "notebook.output.wordWrap": true, // default: false


    // Java settings
        // "[java]": {
        //   "editor.defaultFormatter": "google.java-format"
        // },
        // "java.debug.settings.enableRunDebugCodeLens": false,
        // "java.inlayHints.parameterNames.enabled": "none",

    // JavaScript/TypeScript settings
        "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
        },
        "javascript.suggest.enabled": true,
        // "javascript.validate.enable": true, // defulat: true
        // "javascript.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false, // default: true
        "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
        },

    // JSON/YAML settings
        "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
        },

    // C_C++ settings
        "C_Cpp.formatting": "clangFormat",
        "C_Cpp.clang_format_fallbackStyle": "{ AllowShortFunctionsOnASingleLine: Empty, BraceWrapping: { AfterCaseLabel: true, AfterControlStatement: true, AfterFunction: true, AfterStruct: true, BeforeElse: true, BeforeWhile: true }, BreakBeforeBraces: Custom, ColumnLimit: 100, IndentCaseLabels: true, IndentWidth: 4, SpaceAfterCStyleCast: true, TabWidth: 4 }",
        "C_Cpp.enhancedColorization": "enabled",
        // "C_Cpp.autocomplete": "disabled",
        // "C_Cpp.debugShortcut": false,
        // "C_Cpp.errorSquiggles": "disabled",
        // "C_Cpp.codeFolding": "disabled",
        // "C_Cpp.dimInactiveRegions": false,
        // "C_Cpp.doxygen.generateOnType": false,

    // Dart/Flutter settings
        // "dart.lineLength": 80,
        // "[dart]": {
        //     "editor.formatOnSave": true,
        //     "editor.formatOnType": true,
        //     "editor.rulers": [
        //         80
        //     ],
        // },
        // These were on
        // "dart.previewFlutterUiGuides": true,  // Experimental
        // "dart.previewFlutterUiGuidesCustomTracking": true,  // Experimental
        // "dart.closingLabels": true,

    // Language-specific preferences (other)
        "html.format.indentInnerHtml": true,
        "html.autoClosingTags": true,
        "html.autoCreateQuotes": true,
        // "html.suggest.html5": false,  // suggest only basic HTML tags (no HTML5 specific)

        "Prettier-SQL.keywordCase": "upper",
        // "dart.showMainCodeLens": true, // default: true


    // Codeium / Windsurf (extension)
        // "codeium.enableCodeLens": false,


    // Editor settings
        "editor.minimap.enabled": true,
        "editor.minimap.maxColumn": 100,
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": true,
        "editor.matchBrackets": "always",
        "editor.guides.indentation": true,

        "editor.autoClosingBrackets": "beforeWhitespace", // default "languageDefined"
        "editor.autoClosingQuotes": "beforeWhitespace", // default "languageDefined"

        "editor.colorDecorators": true,
        "editor.emptySelectionClipboard": false,
        "editor.folding": true,
        "editor.foldingHighlight": true,

        "editor.hover.enabled": "on",
        "editor.lightbulb.enabled": "onCode",
        // "editor.codeLens": true, // default: true
        "editor.occurrencesHighlight": "off",
        "editor.selectionHighlight": true,

        // "editor.renderWhitespace": "selection", // default: "selection"

        "editor.stickyScroll.enabled": true,

        // "editor.mouseWheelZoom": true, // default: true
        "editor.smoothScrolling": true,
        "editor.cursorBlinking": "smooth",
        // "editor.cursorStyle": "block-outline",
        // "editor.cursorSmoothCaretAnimation": "on",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,

        "editor.fontSize": 14, // default: 14

        "breadcrumbs.enabled": true,
        // "breadcrumbs.filePath": "on",

        // "problems.visibility": true, // default: true,
        // "problems.decorations.enabled": true, // default: true


    // Editor Quick Suggestions
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": false
        },
        "editor.quickSuggestionsDelay": 10,
        // "editor.suggestOnTriggerCharacters": false,
        // "editor.tabCompletion": "off",
        "editor.parameterHints.enabled": true,
        "editor.suggest.selectionMode": "always", // default "always"
        "editor.suggest.showStatusBar": true,
        "editor.acceptSuggestionOnEnter": "off",


    // File management preferences
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        // "files.exclude": {
        //     "**/.*": true
        // },
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "files.eol": "\n",


    // Port forwarding and remote-specific settings
        "remote.restoreForwardedPorts": false,


    // Git settings + GitDoc
        "git.autofetch": true,
        "git.confirmSync": false,
        // "git.decorations.enabled": true, // default: true
        // "scm.diffDecorations":"all", // default: "all"
        "gitdoc.enabled": true,


    // Accessibility settings
        "accessibility.signals.terminalBell": {
            "sound": "on"
        },


    // Basic UI preferences
        "diffEditor.diffAlgorithm": "advanced",
        // "diffEditor.ignoreTrimWhitespace": false, // default: true
        "explorer.compactFolders": false, // default: true
        "explorer.autoOpenDroppedFile": false, // default: true
        "window.autoDetectColorScheme": true,
        "workbench.editor.closeOnFileDelete": true,
        "workbench.editor.enablePreview": false,
        "workbench.editorAssociations": {
            "*.wav": "vscode.audioPreview"
        },
        // "workbench.iconTheme": "vs-minimal", // default "vs-seti"
        "workbench.preferredDarkColorTheme": "GitHub Dark Default",
        "workbench.preferredLightColorTheme": "GitHub Light Default",
        "workbench.statusBar.visible": true,
        // "workbench.layoutControl.enabled": false,
        // "window.commandCenter": false,
        "workbench.list.smoothScrolling": true,
        "workbench.editor.labelFormat": "default",
        "workbench.startupEditor": "none",
        "workbench.tips.enabled": true,
        "chat.disableAIFeatures": true,

        "workbench.colorCustomizations": {
            "editorBracketMatch.foreground":"#ff0000",
            // "editorBracketMatch.foreground":"#ff0000",
            // "editorBracketMatch.border": "default",
            // "editorBracketMatch.background": "default"
        },
        "workbench.settings.alwaysShowAdvancedSettings": true,



    // Terminal Settings
        "terminal.integrated.smoothScrolling": true,
        "terminal.integrated.cursorBlinking": true,
        "terminal.integrated.copyOnSelection": true,
        "terminal.integrated.shellIntegration.enabled": true,
        "terminal.integrated.suggest.enabled": false,
        // "terminal.integrated.cwd": "/workspaces/LocalDev",


    // Code Spell Checker extension
        "cSpell.enabled": false,
        "cSpell.words": [
            "appbar",
            "AUTOINCREMENT",
            "Cupertino",
            "firestore",
            "flutterfire",
            "gradlew",
            "mynotes",
            "pubspec"
        ],


    // Temporary pytest configuration for current project
        // // "python.testing.pytestArgs": [
